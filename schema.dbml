// ============================================================
// ENUMS (values match app/Enums/*.php)
// ============================================================

Enum purchase_status {
  pending
  completed
  canceled
}

Enum purchase_payment_status {
  paid
  canceled
}

Enum purchase_refund_status {
  paid
}

Enum purchase_return_status {
  pending
  completed
}

Enum sale_return_status {
  pending
  completed
}

Enum inventory_transfer_status {
  pending
  dispatched
  received
  canceled
}

Enum expiration_status {
  pending
  approved
  canceled
}

Enum restock_status {
  pending
  fulfilled
  cancelled
}

Enum contract_status {
  pending
  approved
  rejected
  confirmed
  configured
  active
  completed
  closed
  cancelled
}

Enum installment_status {
  pending
  paid
  overdue
}

Enum installment_payment_method {
  bank
  cash
}

Enum subscription_status {
  active
  cancelled
  completed
}

Enum draw_status {
  pending
  received
  cancelled
  failed
}

Enum inventory_movement_type {
  receive
  return
  transfer_in
  transfer_out
  sale
  expired
  restock_received
  transfer_cancel
  sale_return
  sale_update
  manual
}

Enum wallet_movement_type {
  deposit
  withdrawal
  transfer_in
  transfer_out
  expense
  salary
  installment_payment
  sale_payment
  purchase_payment
  purchase_return
  sale_return
  sale_update
  payment_cancel
  adjustment
}

Enum price_type {
  selling
  installment
  wholesale
}

Enum discount_type {
  percentage
  fixed
}

// ============================================================
// CORE IDENTITY
// ============================================================

Table users {
  id                bigint    [pk, increment]
  name              varchar
  email             varchar   [unique]
  email_verified_at timestamp [null]
  password          varchar
  phone             varchar   [null]
  is_active         boolean   [default: true]
  remember_token    varchar   [null]
  created_by        bigint    [null, ref: > users.id]
  updated_by        bigint    [null, ref: > users.id]
  created_at        timestamp
  updated_at        timestamp
}

Table password_reset_tokens {
  email      varchar   [pk]
  token      varchar
  created_at timestamp [null]
}

Table sessions {
  id            varchar   [pk]
  user_id       bigint    [null, ref: > users.id, note: "indexed"]
  ip_address    varchar   [null]
  user_agent    text      [null]
  payload       text
  last_activity int       [note: "indexed"]
}

Table wilayas {
  id         bigint    [pk, increment]
  name       varchar
  created_by bigint    [null, ref: > users.id]
  updated_by bigint    [null, ref: > users.id]
  created_at timestamp
  updated_at timestamp
}

// ============================================================
// ORGANISATION
// ============================================================

Table branches {
  id         bigint    [pk, increment]
  wilaya_id  bigint    [ref: > wilayas.id]
  name       varchar
  code       varchar   [note: "single char (A to Z)"]
  shop_name  varchar   [null]
  address    text      [null]
  phone      varchar   [null]
  metadata   json      [null]
  created_by bigint    [null, ref: > users.id]
  updated_by bigint    [null, ref: > users.id]
  created_at timestamp
  updated_at timestamp
}

Table accounts {
  id                  bigint    [pk, increment]
  name                varchar
  ccp_number          varchar   [unique]
  ccp_key             varchar
  draw_day            int       [note: "unsignedTinyInteger (0-255)"]
  min_withdraw_amount int
  max_withdraw_count  int
  created_by          bigint    [null, ref: > users.id]
  updated_by          bigint    [null, ref: > users.id]
  created_at          timestamp
  updated_at          timestamp
}

Table branch_accounts {
  id         bigint    [pk, increment]
  account_id bigint    [ref: > accounts.id]
  branch_id  bigint    [ref: > branches.id]
  created_at timestamp
  updated_at timestamp
}

Table user_branches {
  user_id    bigint    [ref: > users.id]
  branch_id  bigint    [ref: > branches.id]
  created_at timestamp
  updated_at timestamp

  indexes {
    (user_id, branch_id) [pk]
  }
}

// ============================================================
// CATALOGUE
// ============================================================

Table categories {
  id         bigint    [pk, increment]
  name       varchar
  created_by bigint    [null, ref: > users.id]
  updated_by bigint    [null, ref: > users.id]
  created_at timestamp
  updated_at timestamp
}

Table types {
  id          bigint    [pk, increment]
  category_id bigint    [ref: > categories.id]
  name        varchar
  created_by  bigint    [null, ref: > users.id]
  updated_by  bigint    [null, ref: > users.id]
  created_at  timestamp
  updated_at  timestamp
}

Table brands {
  id         bigint    [pk, increment]
  name       varchar
  created_by bigint    [null, ref: > users.id]
  updated_by bigint    [null, ref: > users.id]
  created_at timestamp
  updated_at timestamp
}

Table colors {
  id         bigint    [pk, increment]
  name       varchar
  code       varchar   [note: "max 10 chars"]
  created_by bigint    [null, ref: > users.id]
  updated_by bigint    [null, ref: > users.id]
  created_at timestamp
  updated_at timestamp
}

Table products {
  id           bigint    [pk, increment]
  type_id      bigint    [ref: > types.id]
  color_id     bigint    [ref: > colors.id]
  brand_id     bigint    [ref: > brands.id]
  name         varchar
  barcode      varchar   [null, unique]
  min_quantity int       [null]
  created_by   bigint    [null, ref: > users.id]
  updated_by   bigint    [null, ref: > users.id]
  created_at   timestamp
  updated_at   timestamp
}

// ============================================================
// CLIENTS & SUPPLIERS
// ============================================================

Table clients {
  id         bigint    [pk, increment]
  branch_id  bigint    [ref: > branches.id]
  wilaya_id  bigint    [ref: > wilayas.id]
  firstname  varchar
  lastname   varchar
  phone      varchar
  birthdate  date      [null]
  address    varchar   [null]
  occupation varchar   [null]
  employer   varchar   [null]
  salary     decimal
  incomes    json      [null]
  nin        varchar   [unique]
  ccp_number varchar   [unique]
  ccp_key    varchar
  eccp       varchar   [null]
  metadata   json      [null]
  created_by bigint    [null, ref: > users.id]
  updated_by bigint    [null, ref: > users.id]
  created_at timestamp
  updated_at timestamp
}

Table suppliers {
  id         bigint    [pk, increment]
  wilaya_id  bigint    [ref: > wilayas.id]
  name       varchar
  phone      varchar
  email      varchar   [null]
  address    varchar
  metadata   json      [null]
  is_active  boolean   [default: true]
  created_by bigint    [null, ref: > users.id]
  updated_by bigint    [null, ref: > users.id]
  created_at timestamp
  updated_at timestamp
}

// ============================================================
// INVENTORY
// ============================================================

Table inventories {
  id         bigint    [pk, increment]
  branch_id  bigint    [null, ref: > branches.id]
  name       varchar
  created_by bigint    [null, ref: > users.id]
  updated_by bigint    [null, ref: > users.id]
  created_at timestamp
  updated_at timestamp
}

Table stocks {
  id           bigint    [pk, increment]
  inventory_id bigint    [ref: > inventories.id]
  product_id   bigint    [ref: > products.id]
  created_by   bigint    [null, ref: > users.id]
  updated_by   bigint    [null, ref: > users.id]
  created_at   timestamp
  updated_at   timestamp
}

Table batches {
  id               bigint    [pk, increment]
  stock_id         bigint    [ref: > stocks.id]
  source_id        bigint    [null]
  source_type      varchar   [null]
  purchase_price   int
  initial_quantity int
  current_quantity int
  created_by       bigint    [null, ref: > users.id]
  updated_by       bigint    [null, ref: > users.id]
  created_at       timestamp
  updated_at       timestamp
}

Table prices {
  id         bigint      [pk, increment]
  stock_id   bigint      [ref: > stocks.id]
  type       price_type
  amount     int
  created_by bigint      [null, ref: > users.id]
  updated_by bigint      [null, ref: > users.id]
  created_at timestamp
  updated_at timestamp
}

Table inventory_movements {
  id            bigint                  [pk, increment]
  stock_id      bigint                  [ref: > stocks.id]
  inventory_id  bigint                  [ref: > inventories.id]
  product_id    bigint                  [ref: > products.id]
  source_type   varchar                 [null]
  source_id     bigint                  [null]
  movement_type inventory_movement_type
  old_quantity  int                     [null]
  new_quantity  int                     [null]
  quantity      int
  created_by    bigint                  [null, ref: > users.id]
  updated_by    bigint                  [null, ref: > users.id]
  created_at    timestamp
  updated_at    timestamp
}

Table batch_allocations {
  id                    bigint    [pk, increment]
  inventory_movement_id bigint    [ref: > inventory_movements.id]
  batch_id              bigint    [ref: > batches.id]
  quantity              int       [note: "signed; portion of the parent movement's quantity applied to this batch"]
  purchase_price        int       [note: "snapshot of batch.purchase_price at allocation time"]
  created_by            bigint    [null, ref: > users.id]
  updated_by            bigint    [null, ref: > users.id]
  created_at            timestamp
  updated_at            timestamp

  indexes {
    (inventory_movement_id)
    (batch_id)
  }
}

// ============================================================
// TRANSFERS
// ============================================================

Table inventory_transfers {
  id                bigint    [pk, increment]
  from_inventory_id bigint    [ref: > inventories.id]
  to_inventory_id   bigint    [ref: > inventories.id]
  note              varchar   [null]
  status            varchar   [default: 'pending', note: "pending|dispatched|received|canceled"]
  created_by        bigint    [null, ref: > users.id]
  updated_by        bigint    [null, ref: > users.id]
  created_at        timestamp
  updated_at        timestamp
}

Table inventory_transfer_items {
  id                    bigint    [pk, increment]
  inventory_transfer_id bigint    [ref: > inventory_transfers.id]
  stock_id              bigint    [ref: > stocks.id]
  quantity              int
  created_by            bigint    [null, ref: > users.id]
  updated_by            bigint    [null, ref: > users.id]
  created_at            timestamp
  updated_at            timestamp
}

// ============================================================
// PURCHASES
// ============================================================

Table purchases {
  id           bigint          [pk, increment]
  supplier_id  bigint          [ref: > suppliers.id]
  branch_id    bigint          [ref: > branches.id]
  inventory_id bigint          [null, ref: > inventories.id]
  reference    varchar
  status       purchase_status [default: 'pending']
  total_amount int
  net_amount   int             [default: 0]
  paid_amount  int             [default: 0]
  note         varchar         [null]
  created_by   bigint          [null, ref: > users.id]
  updated_by   bigint          [null, ref: > users.id]
  created_at   timestamp
  updated_at   timestamp
}

Table purchase_items {
  id          bigint    [pk, increment]
  purchase_id bigint    [ref: > purchases.id]
  product_id  bigint    [ref: > products.id]
  quantity    int
  price       int
  created_by  bigint    [null, ref: > users.id]
  updated_by  bigint    [null, ref: > users.id]
  created_at  timestamp
  updated_at  timestamp
}

Table purchase_payments {
  id          bigint    [pk, increment]
  purchase_id bigint    [ref: > purchases.id]
  amount      int
  status      varchar   [default: 'paid', note: "paid|canceled"]
  created_by  bigint    [null, ref: > users.id]
  updated_by  bigint    [null, ref: > users.id]
  created_at  timestamp
  updated_at  timestamp
}

Table purchase_returns {
  id          bigint    [pk, increment]
  purchase_id bigint    [ref: > purchases.id]
  reference   varchar
  note        varchar   [null]
  status      varchar   [default: 'pending', note: "pending|completed"]
  created_by  bigint    [null, ref: > users.id]
  updated_by  bigint    [null, ref: > users.id]
  created_at  timestamp
  updated_at  timestamp
}

Table purchase_return_items {
  id                 bigint    [pk, increment]
  purchase_return_id bigint    [ref: > purchase_returns.id]
  purchase_item_id   bigint    [ref: > purchase_items.id]
  quantity           int
  reason             varchar
  created_by         bigint    [null, ref: > users.id]
  updated_by         bigint    [null, ref: > users.id]
  created_at         timestamp
  updated_at         timestamp
}

Table purchase_refunds {
  id                 bigint                [pk, increment]
  purchase_id        bigint                [ref: > purchases.id]
  purchase_return_id bigint                [ref: > purchase_returns.id]
  amount             int
  status             purchase_refund_status [default: 'paid']
  created_by         bigint                [null, ref: > users.id]
  updated_by         bigint                [null, ref: > users.id]
  created_at         timestamp
  updated_at         timestamp
}

// ============================================================
// SALES
// ============================================================

Table sales {
  id              bigint    [pk, increment]
  branch_id       bigint    [ref: > branches.id]
  client_id       bigint    [null, ref: > clients.id]
  reference       varchar
  gross_amount    int
  total_amount    int
  tax_rate        int       [null]
  tax_amount      int       [default: 0]
  discount_type   varchar   [null, note: "percentage|fixed"]
  discount_value  int       [null]
  discount_amount int       [default: 0]
  note            varchar   [null]
  created_by      bigint    [null, ref: > users.id]
  updated_by      bigint    [null, ref: > users.id]
  created_at      timestamp
  updated_at      timestamp
}

Table sale_items {
  id         bigint    [pk, increment]
  sale_id    bigint    [ref: > sales.id]
  product_id bigint    [ref: > products.id]
  stock_id   bigint    [ref: > stocks.id]
  price      int
  quantity   int
  created_by bigint    [null, ref: > users.id]
  updated_by bigint    [null, ref: > users.id]
  created_at timestamp
  updated_at timestamp
}

Table sale_returns {
  id         bigint    [pk, increment]
  sale_id    bigint    [ref: > sales.id]
  reference  varchar
  note       varchar   [null]
  status     varchar   [default: 'pending', note: "pending|completed"]
  created_by bigint    [null, ref: > users.id]
  updated_by bigint    [null, ref: > users.id]
  created_at timestamp
  updated_at timestamp
}

Table sale_return_items {
  id             bigint    [pk, increment]
  sale_return_id bigint    [ref: > sale_returns.id]
  sale_item_id   bigint    [ref: > sale_items.id]
  quantity       int
  reason         varchar   [null]
  created_by     bigint    [null, ref: > users.id]
  updated_by     bigint    [null, ref: > users.id]
  created_at     timestamp
  updated_at     timestamp
}

// ============================================================
// EXPIRATIONS
// ============================================================

Table expirations {
  id           bigint    [pk, increment]
  inventory_id bigint    [ref: > inventories.id]
  reference    varchar
  note         varchar   [null]
  status       varchar   [default: 'pending', note: "pending|approved|canceled"]
  created_by   bigint    [null, ref: > users.id]
  updated_by   bigint    [null, ref: > users.id]
  created_at   timestamp
  updated_at   timestamp
}

Table expiration_items {
  id            bigint    [pk, increment]
  expiration_id bigint    [ref: > expirations.id]
  stock_id      bigint    [ref: > stocks.id]
  quantity      int
  reason        varchar   [null]
  created_by    bigint    [null, ref: > users.id]
  updated_by    bigint    [null, ref: > users.id]
  created_at    timestamp
  updated_at    timestamp
}

// ============================================================
// RESTOCK ORDERS
// ============================================================

Table restocks {
  id                    bigint         [pk, increment]
  branch_id             bigint         [ref: > branches.id]
  reference             varchar
  status                restock_status [default: 'pending']
  note                  varchar        [null]
  fulfilled_with_type   varchar        [null]
  fulfilled_with_id     bigint         [null]
  created_by            bigint         [null, ref: > users.id]
  updated_by            bigint         [null, ref: > users.id]
  created_at            timestamp
  updated_at            timestamp
}

Table restock_items {
  id                 bigint    [pk, increment]
  restock_id         bigint    [ref: > restocks.id]
  product_id         bigint    [ref: > products.id]
  requested_quantity int
  fulfilled_quantity int       [null, default: 0]
  created_by         bigint    [null, ref: > users.id]
  updated_by         bigint    [null, ref: > users.id]
  created_at         timestamp
  updated_at         timestamp
}

// ============================================================
// INSTALLMENT CONTRACTS
// ============================================================

Table contracts {
  id             bigint          [pk, increment]
  client_id      bigint          [ref: > clients.id]
  account_id     bigint          [ref: > accounts.id]
  branch_id      bigint          [ref: > branches.id]
  reference      varchar         [null]
  status         contract_status [default: 'pending']
  max_amount     int             [null]
  advance_amount int             [null]
  months_count   int             [null]
  draw_date      date            [null]
  total_amount   int             [null]
  monthly_amount int             [null]
  note           varchar         [null]
  created_by     bigint          [null, ref: > users.id]
  updated_by     bigint          [null, ref: > users.id]
  created_at     timestamp
  updated_at     timestamp
}

Table contract_items {
  id          bigint    [pk, increment]
  contract_id bigint    [ref: > contracts.id]
  product_id  bigint    [ref: > products.id]
  stock_id    bigint    [ref: > stocks.id]
  price       int
  quantity    int
  created_by  bigint    [null, ref: > users.id]
  updated_by  bigint    [null, ref: > users.id]
  created_at  timestamp
  updated_at  timestamp
}

// ============================================================
// INSTALLMENTS
// ============================================================

Table installments {
  id             bigint               [pk, increment]
  contract_id    bigint               [ref: > contracts.id]
  month_number   int
  amount         int
  status         installment_status   [default: 'pending']
  payment_method varchar              [note: "bank|cash"]
  due_date       date
  created_by     bigint               [null, ref: > users.id]
  updated_by     bigint               [null, ref: > users.id]
  created_at     timestamp
  updated_at     timestamp
}

Table subscriptions {
  id                  bigint              [pk, increment]
  contract_id         bigint              [ref: > contracts.id]
  reference           varchar             [unique]
  subscription_number int
  amount              int
  status              subscription_status [default: 'active']
  created_by          bigint              [null, ref: > users.id]
  updated_by          bigint              [null, ref: > users.id]
  created_at          timestamp
  updated_at          timestamp
}

Table draws {
  id              bigint      [pk, increment]
  subscription_id bigint      [ref: > subscriptions.id]
  installment_id  bigint      [ref: > installments.id]
  month_number    int
  amount          int
  status          draw_status [default: 'pending']
  scheduled_date  date
  created_by      bigint      [null, ref: > users.id]
  updated_by      bigint      [null, ref: > users.id]
  created_at      timestamp
  updated_at      timestamp
}

Table installment_payments {
  id             bigint    [pk, increment]
  installment_id bigint    [unique, ref: > installments.id]
  amount         int
  received_by    bigint    [ref: > users.id]
  note           varchar   [null]
  created_by     bigint    [null, ref: > users.id]
  updated_by     bigint    [null, ref: > users.id]
  created_at     timestamp
  updated_at     timestamp
}

// ============================================================
// WALLET
// ============================================================

Table wallets {
  id         bigint    [pk, increment]
  owner_type varchar   [null]
  owner_id   bigint    [null]
  name       varchar
  balance    decimal   [default: 0]
  created_by bigint    [null, ref: > users.id]
  updated_by bigint    [null, ref: > users.id]
  created_at timestamp
  updated_at timestamp
}

Table wallet_movements {
  id            bigint                [pk, increment]
  wallet_id     bigint                [ref: > wallets.id]
  movement_type wallet_movement_type
  amount        decimal
  old_balance   decimal               [null]
  new_balance   decimal               [null]
  source_type   varchar               [null]
  source_id     bigint                [null]
  note          varchar               [null]
  created_by    bigint                [null, ref: > users.id]
  updated_by    bigint                [null, ref: > users.id]
  created_at    timestamp
  updated_at    timestamp
}

Table wallet_transfers {
  id             bigint    [pk, increment]
  from_wallet_id bigint    [ref: > wallets.id]
  to_wallet_id   bigint    [ref: > wallets.id]
  amount         decimal
  note           varchar   [null]
  created_by     bigint    [null, ref: > users.id]
  updated_by     bigint    [null, ref: > users.id]
  created_at     timestamp
  updated_at     timestamp
}

// ============================================================
// STATUS HISTORY
// ============================================================

Table status_histories {
  id              bigint    [pk, increment]
  statusable_type varchar
  statusable_id   bigint
  from_status     varchar
  to_status       varchar
  changed_by      bigint    [null, ref: > users.id]
  note            varchar   [null]
  changed_at      timestamp
}

// ============================================================
// RBAC (spatie/laravel-permission)
// ============================================================

Table permissions {
  id         bigint    [pk, increment]
  name       varchar
  guard_name varchar
  created_at timestamp
  updated_at timestamp

  indexes {
    (name, guard_name) [unique]
  }
}

Table roles {
  id         bigint    [pk, increment]
  name       varchar
  guard_name varchar
  created_at timestamp
  updated_at timestamp

  indexes {
    (name, guard_name) [unique]
  }
}

Table model_has_permissions {
  permission_id bigint  [ref: > permissions.id]
  model_type    varchar
  model_id      bigint

  indexes {
    (permission_id, model_id, model_type) [pk]
    (model_id, model_type) [name: "model_has_permissions_model_id_model_type_index"]
  }
}

Table model_has_roles {
  role_id    bigint  [ref: > roles.id]
  model_type varchar
  model_id   bigint

  indexes {
    (role_id, model_id, model_type) [pk]
    (model_id, model_type) [name: "model_has_roles_model_id_model_type_index"]
  }
}

Table role_has_permissions {
  permission_id bigint [ref: > permissions.id]
  role_id       bigint [ref: > roles.id]

  indexes {
    (permission_id, role_id) [pk]
  }
}

// ============================================================
// ACTIVITY LOG (spatie/laravel-activitylog)
// ============================================================

Table activity_log {
  id                bigint    [pk, increment]
  log_name          varchar   [null, note: "indexed"]
  description       text
  subject_type      varchar   [null]
  subject_id        bigint    [null]
  event             varchar   [null]
  causer_type       varchar   [null]
  causer_id         bigint    [null]
  attribute_changes json      [null]
  properties        json      [null]
  batch_uuid        varchar   [null]
  created_at        timestamp
  updated_at        timestamp
}

// ============================================================
// MEDIA (spatie/laravel-medialibrary)
// ============================================================

Table media {
  id                    bigint    [pk, increment]
  model_type            varchar
  model_id              bigint
  uuid                  varchar   [null, unique]
  collection_name       varchar
  name                  varchar
  file_name             varchar
  mime_type             varchar   [null]
  disk                  varchar
  conversions_disk      varchar   [null]
  size                  bigint
  manipulations         json
  custom_properties     json
  generated_conversions json
  responsive_images     json
  order_column          int       [null, note: "indexed"]
  created_at            timestamp [null]
  updated_at            timestamp [null]
}

// ============================================================
// AUTH / TOKENS
// ============================================================

Table personal_access_tokens {
  id             bigint    [pk, increment]
  tokenable_type varchar
  tokenable_id   bigint
  name           text
  token          varchar   [unique]
  abilities      text      [null]
  last_used_at   timestamp [null]
  expires_at     timestamp [null, note: "indexed"]
  created_at     timestamp
  updated_at     timestamp
}

// ============================================================
// CACHE
// ============================================================

Table cache {
  key        varchar [pk]
  value      text
  expiration bigint  [note: "indexed"]
}

Table cache_locks {
  key        varchar [pk]
  owner      varchar
  expiration bigint  [note: "indexed"]
}

// ============================================================
// JOBS
// ============================================================

Table jobs {
  id           bigint    [pk, increment]
  queue        varchar   [note: "indexed"]
  payload      text
  attempts     int
  reserved_at  int       [null]
  available_at int
  created_at   int
}

Table job_batches {
  id             varchar [pk]
  name           varchar
  total_jobs     int
  pending_jobs   int
  failed_jobs    int
  failed_job_ids text
  options        text    [null]
  cancelled_at   int     [null]
  created_at     int
  finished_at    int     [null]
}

Table failed_jobs {
  id         bigint    [pk, increment]
  uuid       varchar   [unique]
  connection text
  queue      text
  payload    text
  exception  text
  failed_at  timestamp
}
